{
  "name": "crowns-and-centuries",
  "private": true,
  "version": "0.1.0",
  "description": "A nation-focused grand strategy game on a map of the whole world, from 1066 to 2066.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p tools/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "mapgen:download": "node --use-env-proxy --import tsx tools/mapgen/download.ts",
    "mapgen": "node --max-old-space-size=12288 --import tsx tools/mapgen/build.ts",
    "mapgen:validate": "node --import tsx tools/mapgen/validate.ts",
    "artifact": "node --import tsx tools/artifact/prepare.ts",
    "icons": "node --import tsx tools/icons/extract.ts"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "earcut": "^3.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@playwright/test": "1.56.1",
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
